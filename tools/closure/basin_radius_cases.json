{
  "meta": {
    "suite": "BREP-VTS v1.0",
    "layer": "1.2.ai",
    "description": "Synthetic cases for deterministic basin radius and shell width estimation",
    "notes": [
      "Quantile uses floor index: idx = floor(p * (n-1)).",
      "MAD and sigma_hat are computed on CG-admissible drifts only.",
      "m_hat is clamped to 0.5*epsilon_L_hat if m_hat >= epsilon_L_hat."
    ]
  },
  "cases": [
    {
      "name": "BREP-2: Simple admissible distribution (p=0.80)",
      "_work": "D=[0.01,0.02,0.03,0.10,0.20], n=5, Q_0.8=D[floor(3.2)]=D[3]=0.10; median=0.03, devs=[0,0.01,0.02,0.07,0.17], MAD=0.02, sigma=0.029652, m=max(0.02,0.029652)=0.029652",
      "params": { "p": 0.8, "k": 1.0, "m_min": 0.02 },
      "tol": 1e-12,
      "drifts": [0.01, 0.02, 0.03, 0.10, 0.20],
      "cg_ok":  [true, true, true, true, true],
      "expect": {
        "quantile_eps": 0.10,
        "m_hat": 0.029652
      }
    },
    {
