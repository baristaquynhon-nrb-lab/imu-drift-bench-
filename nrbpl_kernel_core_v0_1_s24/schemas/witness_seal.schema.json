{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "NRBPL_WITNESS_SEAL_v1.0.schema.json",
  "title": "NRBPL Witness Seal v1.0 (Minimal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "artifact", "integrity", "seal"],
  "properties": {
    "spec": {
      "type": "string",
      "const": "NRBPL_WITNESS_SEAL_v1.0"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timestamp_utc", "issuer"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["CANONICAL_SEALED", "DEV_BUILD"]
        },
        "timestamp_utc": {
          "type": "string",
          "minLength": 10
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "bindings": {
      "description": "Optional cross-artifact bindings (audit report sha256, manifest sha256, spec versions, etc.)",
      "type": "object",
      "additionalProperties": true
    }
  }
}
