{
  "registry": "NRBPL_OPCODE_REGISTRY",
  "version": "0.1",
  "status": "NORMATIVE",
  "description": "Frozen NRBPL opcode registry mapped from ASE v1.0",

  "opcode_set": {
    "CTX:TEMPORAL": {
      "args": ["value"],
      "description": "Set temporal/occasion context frame"
    },
    "MOVE_TO": {
      "args": ["location"],
      "description": "Agent moves to a specific location"
    },
    "MOVE_STATE": {
      "args": ["state"],
      "description": "Agent transitions movement state"
    },
    "SEE": {
      "args": ["object"],
      "description": "Agent visually perceives an object"
    },
    "HEAR": {
      "args": ["object"],
      "description": "Agent auditorily perceives an object"
    },
    "IN": {
      "args": ["location"],
      "description": "Object is inside a container/location"
    },
    "OPEN": {
      "args": ["object"],
      "description": "Agent opens a container"
    },
    "IS": {
      "args": ["identity"],
      "description": "Object is identified as a type"
    },
    "HAS": {
      "args": ["attribute"],
      "description": "Object has a physical attribute"
    },
    "DO": {
      "args": ["action"],
      "description": "Agent performs a generic action"
    },
    "MOVE": {
      "args": ["speed"],
      "description": "Object moves with a given speed/manner"
    },
    "GIVE": {
      "args": ["object", "recipient"],
      "description": "Agent gives object to recipient"
    },
    "EAT": {
      "args": ["object"],
      "description": "Agent consumes an object"
    },
    "FEEL": {
      "args": ["state"],
      "description": "Agent experiences an emotional state"
    },
    "HUG": {
      "args": ["target"],
      "description": "Agent hugs target"
    },
    "SAY": {
      "args": ["speech_type", "target"],
      "description": "Agent performs speech act toward target"
    },
    "FACE": {
      "args": ["expression"],
      "description": "Agent displays a facial expression"
    },
    "LOSE": {
      "args": ["object"],
      "description": "Agent loses an object"
    },
    "STATE": {
      "args": ["from_state", "to_state"],
      "description": "Agent transitions between states"
    }
  },

  "syntax_rules": {
    "opcode_regex": "^([A-Z][A-Z0-9_]*):([A-Z_]+)\\(([A-Z0-9_]+)\\)(->([A-Z][A-Z0-9_]*))?$",
    "ctx_regex": "^CTX:([A-Z_]+)\\(([A-Z0-9_]+)\\)$",
    "max_entity_name_length": 32,
    "max_argument_length": 32
  },

  "validation_rules": {
    "stream_must_not_be_empty": true,
    "all_opcodes_must_match_syntax": true,
    "opcodes_must_be_registered": true,
    "max_stream_length": 10000
  },

  "exit_codes": {
    "0": "PASS",
    "2": "FAIL (IO/format error)",
    "3": "REFUSE (spec/gate violation)"
  }
}
