  "meta": {
    "suite": "CCEP-VTS v1.0",
    "layer": "1.2.aj",
    "description": "Synthetic cases for deterministic coupling constant estimation",
    "notes": [
      "K_ML = median(|ΔL|, admissible) / median(|ΔM|, admissible)",
      "K_LT = median(|ΔX|, admissible) / median(|ΔL|, admissible)",
      "K_C = median(|ΔL|, CG_OK) / median(|ΔL|, CG_FAIL)",
      "Q99 outlier removal applied before median computation",
      "Minimum n=5 per axis after filtering"
    ]
  },
